    "k_housing_fit_note": "K_housing = housing.units × housing.household_size × k_housing_fit。默认 0.95：留 5% 给空置、转租、装修周转。",
    "k_jobs_fit_note": "K_jobs = planned_jobs_total ÷ (劳动参与率 × 基准就业率) × k_jobs_fit。默认 1.4：在基准参数（住房 800×4=3200、人数 3000、私营岗位约 1380）下让 K_jobs > K_housing，住房自然成为瓶颈；该值小于 1.4 时岗位会成为瓶颈，迁徙把人口往下压。",
    "k_resource_fit_note": "K_resource = (本城可用资源) ÷ (人均资源消耗) × k_resource_fit。默认 1.1：留 10% 缓冲给储备、突发需求、贸易调整。",
    "k_safety_exp_note": "K_safety = (1 − 魔物风险 × 暂停占比) ^ k_safety_exp。默认 0.5：魔物风险加倍时 K 值损失约 30%。",
    "k_skill_exp_note": "K_skill = (0.65 + 0.35 × skill_factor) ^ k_skill_exp。默认 0.3：高技能城市可微调 K 上限。",
    "k_worktime_exp_note": "K_worktime = worktime_factor ^ k_worktime_exp。默认 0.2：工时损失几乎不直接挤压承载力，因为岗位本身才是约束。",
    "k_service_exp_note": "K_service = (0.5 + 0.5 × school_coverage) ^ k_service_exp。默认 0.2：教育覆盖率对承载力影响有限，主要是长期技能延迟效应。",
    "note": "信用分不等于现金余额。信用影响利率与额度：信用越好，利率越低（§5.4）。curve 为信用分(-1~1)到利差加成的分段线性映射。城市K值（city_capacity）= min(住房承载, 岗位承载) × 资源乘子 × 安全 × 技能 × 工时 × 服务。资源项作调节乘子而非硬瓶颈，避免单资源耗尽瞬间清零；详细公式见 compute_capacity() 函数。",
    "capacity_definition": "K = round( min(K_housing, K_jobs) × K_resource × K_safety × K_skill × K_worktime × K_service )\nK_housing  = housing.units × housing.household_size × k_housing_fit\nK_jobs     = (sum(s.planned_jobs for s in sectors) + public_jobs) ÷ (participation × reference_employment) × k_jobs_fit\nK_resource = clip(monthly_supply ÷ monthly_need, 0.05, 2.0) × k_resource_fit   # 资源作调节乘子，非硬瓶颈\nK_safety   = max(0.05, 1 − magic_risk × default_downtime_share) ^ k_safety_exp\nK_skill    = (0.65 + 0.35 × skill_factor) ^ k_skill_exp\nK_worktime = max(0.05, worktime_factor) ^ k_worktime_exp\nK_service  = (0.5 + 0.5 × school_coverage) ^ k_service_exp\n瓶颈仅取住房与岗位的较小者；资源紧张时 K 按自给率收缩,但不归零。",
    "_implementation": {
      "new_borrowing_cap_months_of_tax": "待接入空间/政策/逐技能模型"
    }
